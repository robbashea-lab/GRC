exports[`CIS IG1 programme card uses compact shared metrics 1`] = `"<section class=\\"bd-card\\" aria-labelledby=\\"bd-cis-heading\\"><div class=\\"bd-card-head\\"><h2 id=\\"bd-cis-heading\\">CIS IG1</h2><a href=\\"/compliance/cis-ig1\\">Open workspace</a></div><p class=\\"bd-muted bd-small\\">CIS Controls v8.1 IG1</p><div class=\\"bd-cis-chart\\"><svg class=\\"bd-donut\\" viewBox=\\"0 0 42 42\\" role=\\"img\\" aria-label=\\"CIS IG1: 2 Implemented (33.3%, 2 of 6), 1 Partially Implemented (16.7%, 1 of 6), 2 Not Implemented (33.3%, 2 of 6), 1 Not Assessed (16.7%, 1 of 6)\\"><circle cx=\\"21\\" cy=\\"21\\" r=\\"15.9\\" class=\\"bd-donut-track\\"></circle><circle cx=\\"21\\" cy=\\"21\\" r=\\"15.9\\" class=\\"bd-seg-addressed\\" stroke-dasharray=\\"33.33333333333333 66.66666666666667\\" stroke-dashoffset=\\"25\\"><title>Implemented · 33.3% · 2 of 6 safeguards</title></circle><circle cx=\\"21\\" cy=\\"21\\" r=\\"15.9\\" class=\\"bd-seg-in_progress\\" stroke-dasharray=\\"16.666666666666664 83.33333333333334\\" stroke-dashoffset=\\"-8.333333333333329\\"><title>Partially Implemented · 16.7% · 1 of 6 safeguards</title></circle><circle cx=\\"21\\" cy=\\"21\\" r=\\"15.9\\" class=\\"bd-seg-needs_attention\\" stroke-dasharray=\\"33.33333333333333 66.66666666666667\\" stroke-dashoffset=\\"-24.999999999999993\\"><title>Not Implemented · 33.3% · 2 of 6 safeguards</title></circle><circle cx=\\"21\\" cy=\\"21\\" r=\\"15.9\\" class=\\"bd-seg-not_assessed\\" stroke-dasharray=\\"16.666666666666664 83.33333333333334\\" stroke-dashoffset=\\"-58.33333333333332\\"><title>Not Assessed · 16.7% · 1 of 6 safeguards</title></circle><text x=\\"21\\" y=\\"23.7\\" class=\\"bd-donut-value\\">33%</text></svg><ul class=\\"bd-legend\\"><li><a href=\\"/compliance/cis-ig1?view=addressed\\"><span class=\\"bd-swatch bd-seg-addressed\\" aria-hidden=\\"true\\"></span><span>Implemented</span><strong>2</strong></a></li><li><a href=\\"/compliance/cis-ig1?view=in_progress\\"><span class=\\"bd-swatch bd-seg-in_progress\\" aria-hidden=\\"true\\"></span><span>Partially Implemented</span><strong>1</strong></a></li><li><a href=\\"/compliance/cis-ig1?view=needs_attention\\"><span class=\\"bd-swatch bd-seg-needs_attention\\" aria-hidden=\\"true\\"></span><span>Not Implemented</span><strong>2</strong></a></li><li><a href=\\"/compliance/cis-ig1?view=not_assessed\\"><span class=\\"bd-swatch bd-seg-not_assessed\\" aria-hidden=\\"true\\"></span><span>Not Assessed</span><strong>1</strong></a></li><li><a href=\\"/compliance/cis-ig1?view=not_applicable\\"><span class=\\"bd-swatch bd-seg-not_applicable\\" aria-hidden=\\"true\\"></span><span>Not Applicable</span><strong>1</strong></a></li></ul></div><dl class=\\"assessment-metrics\\" aria-label=\\"Assessment metrics\\"><div class=\\"assessment-metric is-implemented\\"><dt>Implemented</dt><dd><strong>33%</strong><span>2 of 6</span></dd></div><div class=\\"assessment-metric\\"><dt>Assessed</dt><dd><strong>83%</strong><span>5 of 6</span></dd></div></dl><ul class=\\"bd-gaps\\" aria-label=\\"CIS verification gaps\\"><li><a href=\\"/compliance/cis-ig1?view=unremediated\\" class=\\"is-critical\\"><span>Gaps without a finding</span><strong>2</strong></a></li><li><a href=\\"/compliance/cis-ig1?view=needs_attention\\" class=\\"is-critical\\"><span>Not Implemented</span><strong>2</strong></a></li><li><a href=\\"/compliance/cis-ig1?view=stale\\" class=\\"is-clear\\"><span>Validation older than 12 months</span><strong>0</strong></a></li><li><a href=\\"/compliance/cis-ig1?view=unevidenced\\" class=\\"is-attention\\"><span>Implemented without evidence</span><strong>1</strong></a></li></ul></section>"`;
