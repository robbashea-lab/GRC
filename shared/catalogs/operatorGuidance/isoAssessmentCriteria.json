      "trigger": null
    },
    "4.2": {
      "criteria": [
        {
          "id": "4.2:parties",
          "text": "Relevant interested parties are identified."
        },
        {
          "id": "4.2:requirements",
          "text": "Those parties' relevant requirements are determined."
        },
        {
