    "5.1": {
      "criteria": [
        {
          "id": "5.1:policy",
          "text": "Leadership ensures the security policy is established.",
          "source_reference": "5.1 a"
        },
        {
          "id": "5.1:objectives",
          "text": "Leadership ensures security objectives are established.",
          "source_reference": "5.1 a"
        },
        {
          "id": "5.1:strategy",
          "text": "Policy and objectives align with organizational direction.",
          "source_reference": "5.1 a"
        },
        {
          "id": "5.1:integration",
          "text": "ISMS requirements are integrated into business processes.",
          "source_reference": "5.1 b"
        },
        {
          "id": "5.1:resources",
          "text": "Leadership ensures ISMS resources are available.",
          "source_reference": "5.1 c"
        },
        {
          "id": "5.1:communication",
          "text": "Leadership communicates the importance of effective security and meeting ISMS requirements.",
          "source_reference": "5.1 d"
        },
        {
          "id": "5.1:outcomes",
          "text": "Leadership ensures intended ISMS outcomes are achieved.",
          "source_reference": "5.1 e"
        },
        {
          "id": "5.1:people",
          "text": "Leadership directs and supports people contributing to ISMS effectiveness.",
          "source_reference": "5.1 f"
        },
        {
          "id": "5.1:improvement",
          "text": "Leadership promotes continual improvement.",
          "source_reference": "5.1 g"
        },
        {
          "id": "5.1:management",
          "text": "Leadership supports other managers in their security responsibilities.",
          "source_reference": "5.1 h"
        }
      ],
      "coverage": "verified",
      "source": [
        {
          "url": "https://preview.sist.si/sist-preview/82875/726bcf58250e43d9a666b4d929c8fbdb/ISO-IEC-27001-2022.pdf",
