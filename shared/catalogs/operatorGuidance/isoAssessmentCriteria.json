    "6.1.1": {
      "criteria": [
        {
          "id": "6.1.1:context",
          "text": "ISMS planning considers organizational context.",
          "source_reference": "6.1.1 intro"
        },
        {
          "id": "6.1.1:requirements",
          "text": "ISMS planning considers interested-party requirements.",
          "source_reference": "6.1.1 intro"
        },
        {
          "id": "6.1.1:risks",
          "text": "Risks requiring attention are determined.",
          "source_reference": "6.1.1 intro"
        },
        {
          "id": "6.1.1:opportunities",
          "text": "Opportunities requiring attention are determined.",
          "source_reference": "6.1.1 intro"
        },
        {
          "id": "6.1.1:outcomes",
          "text": "Selected risks and opportunities address intended ISMS outcomes.",
          "source_reference": "6.1.1 a"
        },
        {
          "id": "6.1.1:effects",
          "text": "Selected risks and opportunities address unwanted effects.",
          "source_reference": "6.1.1 b"
        },
        {
          "id": "6.1.1:improvement",
          "text": "Selected risks and opportunities address continual improvement.",
          "source_reference": "6.1.1 c"
        },
        {
          "id": "6.1.1:actions",
          "text": "Actions addressing selected risks and opportunities are planned.",
          "source_reference": "6.1.1 d"
        },
        {
          "id": "6.1.1:integration",
          "text": "Integration of those actions into ISMS processes is planned.",
          "source_reference": "6.1.1 e 1"
        },
        {
          "id": "6.1.1:implementation",
          "text": "Implementation of those actions is planned.",
          "source_reference": "6.1.1 e 1"
        },
        {
          "id": "6.1.1:evaluation",
          "text": "Evaluation of those actions’ effectiveness is planned.",
          "source_reference": "6.1.1 e 2"
        }
      ],
      "coverage": "verified",
      "source": [
        {
          "url": "https://preview.sist.si/sist-preview/82875/726bcf58250e43d9a666b4d929c8fbdb/ISO-IEC-27001-2022.pdf",
          "section": "6.1.1"
        }
      ],
      "trigger": "When planning the ISMS."
    },
    "6.1.2": {
      "criteria": [
        {
          "id": "6.1.2:defined",
          "text": "A security risk-assessment process is defined.",
          "source_reference": "6.1.2 intro"
        },
        {
          "id": "6.1.2:applied",
          "text": "The risk-assessment process is applied.",
          "source_reference": "6.1.2 intro"
        },
        {
          "id": "6.1.2:acceptance",
          "text": "Risk-acceptance criteria are established.",
          "source_reference": "6.1.2 a 1"
        },
        {
          "id": "6.1.2:acceptance-maintained",
          "text": "Risk-acceptance criteria are maintained.",
          "source_reference": "6.1.2 a 1"
        },
        {
          "id": "6.1.2:assessment",
          "text": "Criteria for conducting risk assessments are established.",
          "source_reference": "6.1.2 a 2"
        },
        {
          "id": "6.1.2:assessment-maintained",
          "text": "Risk-assessment criteria are maintained.",
          "source_reference": "6.1.2 a 2"
        },
        {
          "id": "6.1.2:consistent",
          "text": "Repeated assessments produce consistent results.",
          "source_reference": "6.1.2 b"
        },
        {
          "id": "6.1.2:valid",
          "text": "Repeated assessments produce valid results.",
          "source_reference": "6.1.2 b"
        },
        {
          "id": "6.1.2:comparable",
          "text": "Repeated assessments produce comparable results.",
          "source_reference": "6.1.2 b"
        },
        {
          "id": "6.1.2:confidentiality",
          "text": "Confidentiality-loss risks to information are identified.",
          "source_reference": "6.1.2 c 1"
        },
        {
          "id": "6.1.2:integrity",
          "text": "Integrity-loss risks to information are identified.",
          "source_reference": "6.1.2 c 1"
        },
        {
          "id": "6.1.2:availability",
          "text": "Availability-loss risks to information are identified.",
          "source_reference": "6.1.2 c 1"
        },
        {
          "id": "6.1.2:scope",
          "text": "Risk identification covers information within ISMS scope.",
          "source_reference": "6.1.2 c 1"
        },
        {
          "id": "6.1.2:owners",
          "text": "Risk owners are identified.",
          "source_reference": "6.1.2 c 2"
        },
        {
          "id": "6.1.2:consequences",
          "text": "Potential consequences are assessed.",
          "source_reference": "6.1.2 d 1"
        },
        {
          "id": "6.1.2:likelihood",
          "text": "Realistic likelihood is assessed.",
          "source_reference": "6.1.2 d 2"
        },
        {
          "id": "6.1.2:levels",
          "text": "Risk levels are determined.",
          "source_reference": "6.1.2 d 3"
        },
        {
          "id": "6.1.2:comparison",
          "text": "Analysis results are compared with risk criteria.",
          "source_reference": "6.1.2 e 1"
        },
        {
          "id": "6.1.2:priorities",
          "text": "Risks are prioritized for treatment.",
          "source_reference": "6.1.2 e 2"
        },
        {
          "id": "6.1.2:documented",
          "text": "Documented information about the assessment process is retained.",
          "source_reference": "6.1.2 closing"
        }
      ],
      "coverage": "verified",
      "source": [
        {
          "url": "https://preview.sist.si/sist-preview/82875/726bcf58250e43d9a666b4d929c8fbdb/ISO-IEC-27001-2022.pdf",
          "section": "6.1.2"
        }
      ],
      "trigger": null
    },
    "6.1.3": {
      "criteria": [
        {
          "id": "6.1.3:defined",
          "text": "A security risk-treatment process is defined.",
          "source_reference": "6.1.3 intro"
        },
        {
          "id": "6.1.3:applied",
          "text": "The risk-treatment process is applied.",
          "source_reference": "6.1.3 intro"
        },
        {
          "id": "6.1.3:options",
          "text": "Treatment options account for risk-assessment results.",
          "source_reference": "6.1.3 a"
        },
        {
          "id": "6.1.3:controls",
          "text": "All controls necessary for chosen treatment options are determined.",
          "source_reference": "6.1.3 b"
        },
        {
          "id": "6.1.3:annex-comparison",
          "text": "Necessary controls are compared with Annex A.",
          "source_reference": "6.1.3 c"
        },
        {
          "id": "6.1.3:omissions",
          "text": "The comparison verifies no necessary controls were omitted.",
          "source_reference": "6.1.3 c"
        },
        {
          "id": "6.1.3:soa-controls",
          "text": "The SoA identifies necessary controls, including controls beyond Annex A when needed.",
          "source_reference": "6.1.3 d"
        },
        {
          "id": "6.1.3:soa-inclusion",
          "text": "The SoA justifies including necessary controls.",
          "source_reference": "6.1.3 d"
        },
        {
          "id": "6.1.3:soa-implementation",
          "text": "The SoA records whether necessary controls are implemented.",
          "source_reference": "6.1.3 d"
        },
        {
          "id": "6.1.3:soa-exclusions",
          "text": "The SoA justifies every excluded Annex A control.",
          "source_reference": "6.1.3 d"
        },
        {
          "id": "6.1.3:plan",
          "text": "A risk-treatment plan is formulated.",
          "source_reference": "6.1.3 e"
        },
        {
          "id": "6.1.3:approval",
          "text": "Risk owners approve the treatment plan.",
          "source_reference": "6.1.3 f"
        },
        {
          "id": "6.1.3:acceptance",
          "text": "Risk owners accept residual security risks.",
          "source_reference": "6.1.3 f"
        },
        {
          "id": "6.1.3:documented",
          "text": "Documented information about the treatment process is retained.",
          "source_reference": "6.1.3 closing"
        }
      ],
      "coverage": "verified",
      "source": [
        {
          "url": "https://preview.sist.si/sist-preview/82875/726bcf58250e43d9a666b4d929c8fbdb/ISO-IEC-27001-2022.pdf",
          "section": "6.1.3"
        }
      ],
      "trigger": null
    },
