        },
        {
          "id": "4.4:implemented",
          "text": "The ISMS is implemented in accordance with the standard."
        },
        {
          "id": "4.4:maintained",
          "text": "The ISMS is maintained."
        },
        {
          "id": "4.4:improved",
          "text": "The ISMS continually improves."
        }
      ],
