        }
      ],
      "trigger": null
    },
    "5.2": {
      "criteria": [
        {
          "id": "5.2:purpose",
          "text": "Leadership establishes a security policy appropriate to organizational purpose.",
          "source_reference": "5.2 a"
        },
        {
          "id": "5.2:objectives",
          "text": "The policy includes objectives or a basis for setting them.",
          "source_reference": "5.2 b"
        },
        {
          "id": "5.2:requirements",
          "text": "The policy commits to meeting applicable security requirements.",
          "source_reference": "5.2 c"
        },
        {
          "id": "5.2:improvement",
          "text": "The policy commits to continual ISMS improvement.",
          "source_reference": "5.2 d"
        },
        {
          "id": "5.2:documented",
          "text": "The policy is available as documented information.",
          "source_reference": "5.2 e"
        },
        {
          "id": "5.2:communication",
          "text": "The policy is communicated internally.",
          "source_reference": "5.2 f"
        },
        {
          "id": "5.2:parties",
          "text": "The policy is available to interested parties as appropriate.",
          "source_reference": "5.2 g"
        }
      ],
      "coverage": "verified",
      "source": [
