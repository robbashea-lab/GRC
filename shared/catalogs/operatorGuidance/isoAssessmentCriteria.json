    "4.3": {
      "criteria": [
        {
          "id": "4.3:scope",
          "text": "ISMS boundaries and applicability are determined."
        },
        {
          "id": "4.3:context",
          "text": "Scope determination considers internal and external context."
        },
        {
          "id": "4.3:requirements",
          "text": "Scope determination considers interested-party requirements."
        },
        {
          "id": "4.3:interfaces",
          "text": "Scope determination considers interfaces and dependencies with other organizations."
        },
        {
